<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>br.gov.saude</groupId>
    <artifactId>saur</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>SAUR</name>
    <description>Sistema de Avaliacao de Urgencia Renal</description>

    <properties>
        <java.version>21</java.version>
        <!-- Teste E2E (Playwright) sempre abre o browser visivel por padrao.
             Para rodar sem janela (ex.: CI): mvn verify -Pe2e -Dsaur.e2e.headed=false -->
        <saur.e2e.headed>true</saur.e2e.headed>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Front-end (Bootstrap via WebJars) -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>bootstrap</artifactId>
            <version>5.3.8</version>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>bootstrap-icons</artifactId>
            <version>1.11.3</version>
        </dependency>
        <!-- Resolve /webjars/<lib>/... SEM a versao no caminho (o resolver
             acha a versao real no classpath). Sem isso, o numero de versao
             fica hardcoded no layout.html e um upgrade no pom.xml que esqueca
             de atualizar o template derruba TODO o CSS/JS (incidente real:
             bootstrap 5.3.3 -> 5.3.8, "App ficou sem CSS/JS no login").
             Versao gerida pelo BOM do Spring Boot; auto-configura o
             LiteWebJarsResourceResolver na resource chain. -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-lite</artifactId>
        </dependency>

        <!-- Geracao de PDF (Relatorio Final) -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.34</version>
        </dependency>


        <!-- Bancos -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.13</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <!-- Gera spring-configuration-metadata.json (a partir de
             @ConfigurationProperties + META-INF/additional-spring-configuration-metadata.json)
             para o IDE reconhecer as propriedades custom (app.*, sgpur.*) em
             vez de marcar "Unknown property" no application.yml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- E2E de navegador (bot clicando na UI real) - testes *IT, rodam
             separado via failsafe (mvn verify -Pe2e), nunca no mvn test
             normal (144 testes rapidos). Ver docs/E2E-PLAYWRIGHT.md. -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.61.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- mvn test / .\test.ps1 continuam rodando so *Test.java (surefire padrao),
                 sem tocar nos testes E2E (*IT.java), que sao lentos e exigem browser. -->

            <!-- Robo de inspecao E2E em PRODUCAO (RoboProducaoMain, src/test/.../e2e/prod/):
                 programa Java standalone, nao teste JUnit. Sem <executions>/<phase> aqui de
                 proposito - so' roda quando invocado explicitamente via
                 "mvn test-compile exec:java" (ver e2e-prod.ps1), nunca durante mvn
                 test/package/verify normais. Roda NO MESMO JVM do Maven (forked=false,
                 default do goal "java") - um "-Dsaur.e2e.adminPassword=..." na linha de
                 comando do mvn ja chega direto em System.getProperty(), sem a complicacao
                 de propagacao pra processo forkado que o Failsafe (*IT.java) tem. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>br.gov.saude.sgpur.e2e.prod.RoboProducaoMain</mainClass>
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Ativado com "mvn verify -Pe2e": roda os testes *IT.java (Playwright)
             via failsafe, separados da suite rapida do dia a dia. -->
        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <!-- Failsafe forka um processo Java separado para rodar os
                                 *IT.java; sem isso, "-Dsaur.e2e.headed=true" passado no
                                 mvn nao chega la e o browser sempre roda headless. -->
                            <!-- O robo de inspecao de PRODUCAO mora em e2e/prod/ mas NAO
                                 sao classes *IT.java (nao e' JUnit) - roda so' via
                                 "exec:java" (ver RoboProducaoMain), nunca pego pelo
                                 Failsafe. Nao precisa de exclude aqui por causa disso. -->
                            <systemPropertyVariables>
                                <saur.e2e.headed>${saur.e2e.headed}</saur.e2e.headed>
                            </systemPropertyVariables>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>
</project>
