<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>saur</groupId>
    <artifactId>robo-navegador-saur</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!--
      Robô autônomo que navega o SAUR (projeto ../urgencia) num navegador real
      e reporta o que está quebrado: HTTP != 2xx, erro de JS, CSS que não
      carregou, estouro horizontal de layout, dropdown/aba/collapse do Bootstrap
      que não responde (bug real desta base em 2026-08).

      É SÓ LEITURA: segue links <a href> (GET), clica só em gatilhos seguros
      (dropdown/tab/collapse) e NUNCA envia formulário. Recusa host que não seja
      localhost a menos que liberado explicitamente na config.

      Standalone de propósito — não faz parte do build Maven do SAUR.
    -->

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <playwright.version>1.61.0</playwright.version>
        <exec.mainClass>saur.robo.Robo</exec.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>robo-navegador-saur</finalName>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${exec.mainClass}</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>fatjar</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
