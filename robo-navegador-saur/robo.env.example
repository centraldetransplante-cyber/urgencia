# Copie para "robo.env" e ponha a senha real. robo.env está no .gitignore.
#   cp robo.env.example robo.env    &&    edite
#
# Depois disso, ./run.sh (ou .\run.ps1) roda contra produção SEM perguntar nada.
# Um KEY=VALOR por linha. Sem aspas, sem espaços em volta do = é o mais seguro.

SAUR_PROD_ADMIN=coloque-aqui-a-senha-do-admin-de-producao

# (opcional) logins dos portais, se você criar em /usuarios:
# SAUR_PROD_AVALIADOR_USER=fulano
# SAUR_PROD_AVALIADOR_PASS=...
